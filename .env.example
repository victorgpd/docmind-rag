# Tudo roda local por padrao. Nenhuma chave externa e necessaria.
NODE_ENV=development
API_PORT=3001
JWT_SECRET=dev-only-change-me
# Banco: vazio => PGlite em PGLITE_DIR. Setar => Postgres real (docker compose em infra/).
DATABASE_URL=
PGLITE_DIR=./data/pglite
# Fila: vazio => em memoria. Setar => BullMQ/Redis.
REDIS_URL=
# Storage: filesystem local por padrao. S3_ENDPOINT setado => S3/MinIO.
STORAGE_DIR=./data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# LLM: local (padrao, sem rede) | ollama (requer OLLAMA_URL) | openai (requer OPENAI_API_KEY)
# openai ENVIA perguntas e trechos de documentos a api.openai.com e cobra por token. Trocar de provider ou de modelo de
# embedding exige reindexar os documentos (pnpm reindex --yes): vetores de providers diferentes nao sao comparaveis.
LLM_PROVIDER=local
# Chave da OpenAI: so aqui, no .env (nunca no codigo, nunca commitada). Vazia enquanto LLM_PROVIDER=local.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Embeddings pedem dimensions=384 (schema vector(384)). Chat: modelo barato e atual; confira precos em openai.com/api/pricing
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=all-minilm
# Documentos processados em paralelo por worker
WORKER_CONCURRENCY=1
# Tetos da ingestao (paginas de PDF, chunks, DOCX descomprimido em MB e razao, segundos por job)
INGEST_MAX_PAGES=500
INGEST_MAX_CHUNKS=5000
INGEST_MAX_DOCX_MB=100
INGEST_MAX_DOCX_RATIO=100
INGEST_JOB_TIMEOUT_S=300
# Contexto de cada chunk gerado por LLM (opt-in). AVISO: 1 chamada de chat POR CHUNK; com provedor externo custa tokens e envia o texto do documento de novo. Padrao false = frase deterministica.
INGEST_LLM_CONTEXT=false

# Uso/cobranca (USD por 1M de tokens; 0 = gratis)
MONTHLY_TOKEN_LIMIT=10000000
# Teto mensal somando todas as organizacoes (0 = desligado); cadastros por IP/24 h (vazio = 5; 0 = desligado); false fecha o cadastro
GLOBAL_MONTHLY_TOKEN_LIMIT=2000000
REGISTRATION_LIMIT_PER_IP_PER_DAY=
REGISTRATION_ENABLED=true
# Conta de demonstracao somente leitura (POST /auth/demo). Com PGlite a API a prepara no boot; com Postgres rode apps/api/src/scripts/demo-maintenance.ts
DEMO_LOGIN_ENABLED=false
DEMO_USER_EMAIL=
USAGE_PRICE_IN_PER_1M=0
USAGE_PRICE_OUT_PER_1M=0
# Busca/RAG (defaults calibrados nos evals com o reranker local)
# Abaixo desta relevancia (0..1) o chat/agente respondem "nao encontrei"; 0 desliga. Recalibre ao trocar de reranker/corpus.
RAG_MIN_RELEVANCE=0.17
# Pesos relativos da ordenacao dos trechos: rerank, similaridade vetorial, fusao RRF
RAG_W_RERANK=0.8
RAG_W_SIM=0.1
RAG_W_RRF=0.1
# Trechos enviados ao gerador (1-20)
RAG_TOP_K=6
# Tentativas/min por IP em /auth/login e /auth/register (por e-mail: metade)
AUTH_RATE_LIMIT=10
# Atras de proxy reverso: true | numero de saltos | CIDRs. Vazio = desligado.
TRUST_PROXY=
# Opcional: header com o IP do cliente (ex.: cf-connecting-ip). So vale se o salto direto for confiavel por TRUST_PROXY (CIDRs ou saltos, nunca true).
# Producao (Cloudflare -> cloudflared -> web -> api): TRUST_PROXY=2 basta; alternativa: TRUST_PROXY=loopback,uniquelocal (+ CLIENT_IP_HEADER=cf-connecting-ip).
CLIENT_IP_HEADER=
# Protege GET /metrics (16+ caracteres). Vazio = so loopback.
METRICS_TOKEN=
# Origins do CORS, separados por virgula (nunca *)
CORS_ORIGINS=http://localhost:3000
# Rate limit por minuto e por usuario (a organizacao soma ate 5x). /auth tem limite proprio (AUTH_RATE_LIMIT).
# Leituras (GET/HEAD); abrir um SSE conta 1, os eventos do stream nao contam.
RATE_LIMIT_READ=300
# Escritas, uploads e chat (POST/PATCH/DELETE)
RATE_LIMIT_WRITE=60

# --- Web (Next.js) ---
# Destino do proxy /api/v1 (lido no BUILD do Next: rewrites). No compose: http://api:3001
API_URL=http://localhost:3001
# Base da API vista pelo navegador; vazio = mesma origem (usa o proxy acima)
NEXT_PUBLIC_API_URL=
# 1 = output standalone (so no build do Docker; no Windows falha por symlink)
NEXT_STANDALONE=
# Pasta de build do Next (o e2e usa uma separada, ex.: .next-e2e)
NEXT_DIST_DIR=

# --- scripts/seed-demo.ts (pnpm demo:seed) ---
DEMO_API_URL=http://localhost:3001
# ms de espera por documento ate ficar pronto
DEMO_WAIT_MS=60000
