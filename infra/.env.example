# Copie para infra/.env. Senhas e JWT_SECRET abaixo sao SO PARA DEV; troque em producao. Todos os valores tem default no compose; so troque em producao.
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind
POSTGRES_DB=docmind
# Redis exige senha (use caracteres seguros para URL). SO PARA DEV; troque em producao.
REDIS_PASSWORD=dev-redis-password
MINIO_ROOT_USER=docmind
MINIO_ROOT_PASSWORD=docmind-secret
S3_BUCKET=docmind
# >= 32 caracteres (a API recusa menos). TROQUE EM PRODUCAO: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-in-production-0123456789
# LLM: local (padrao, sem rede) | ollama (requer OLLAMA_URL)
LLM_PROVIDER=local
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=all-minilm
WORKER_CONCURRENCY=1
# Tetos da ingestao (paginas de PDF, chunks, DOCX descomprimido em MB e razao, segundos por job)
INGEST_MAX_PAGES=500
INGEST_MAX_CHUNKS=5000
INGEST_MAX_DOCX_MB=100
INGEST_MAX_DOCX_RATIO=100
INGEST_JOB_TIMEOUT_S=300
# Contexto de cada chunk gerado por LLM (opt-in). AVISO: 1 chamada de chat POR CHUNK; com provedor externo custa tokens e envia o texto do documento de novo. Padrao false = frase deterministica.
INGEST_LLM_CONTEXT=false
# API: origem(ns) do web permitidas no CORS (separe por virgula)
CORS_ORIGINS=http://localhost:3000
# 1 = confia no x-forwarded-for do proxy do Next (necessario para o rate limit por IP)
TRUST_PROXY=1
# /metrics so com este token (>= 16 caracteres) ou via loopback; vazio = so loopback
METRICS_TOKEN=
# limite por minuto por IP em /auth/*
AUTH_RATE_LIMIT=10
# portas no host (mude se ja houver Postgres/Redis local)
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=3000
API_PORT=3001
