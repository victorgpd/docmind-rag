# Copie para .env.production ao lado do docker-compose.prod.yml na VPS (~/docmind; chmod 600) e preencha. NUNCA commite o arquivo real (esta no .gitignore).
# Uso: veja o cabecalho de infra/docker-compose.prod.yml e docs/DEPLOY.md
# Versao das imagens do GHCR: latest ou sha-<7 chars> do commit
IMAGE_TAG=latest
NODE_ENV=production

# Hostname publico do DocMind (so informativo: o real e configurado no tunel da Cloudflare).
PUBLIC_HOSTNAME=docmind.SEU_DOMINIO
# Mesma origem (o Next faz o proxy da API), entao o CORS quase nao se aplica; deixe o proprio hostname
CORS_ORIGINS=https://docmind.SEU_DOMINIO

# --- Segredos: gere cada um com `openssl rand -hex 32` (JWT_SECRET exige >= 32 caracteres) ---
JWT_SECRET=
POSTGRES_PASSWORD=
# so caracteres seguros para URL (hex serve)
REDIS_PASSWORD=
# >= 16 caracteres; /metrics exige "Authorization: Bearer <token>"
METRICS_TOKEN=

POSTGRES_USER=docmind
POSTGRES_DB=docmind

# --- Storage ---
# Padrao: MinIO interno (suba com --profile minio). S3_ACCESS_KEY/S3_SECRET_KEY viram o login root do MinIO (>= 8 caracteres o segredo).
S3_ENDPOINT=http://minio:9000
S3_BUCKET=docmind
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Alternativa Cloudflare R2: nao use --profile minio e troque por
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_BUCKET=<bucket criado no R2>
#   S3_ACCESS_KEY / S3_SECRET_KEY = token S3 do R2 (R2 > Manage API tokens)

# --- LLM ---
# openai envia perguntas e trechos a api.openai.com; local = sem rede (qualidade menor)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Ranking/abstencao do RAG. Vazio = padrao do codigo (0.17 e 0.8/0.1/0.1, calibrados com o provider local).
# Recomendado com LLM_PROVIDER=openai (calibrado em evals/calib, sem o held-out; veja evals/README.md):
# RAG_MIN_RELEVANCE=0.10
# RAG_W_RERANK=0.5
# RAG_W_SIM=0.4
# RAG_W_RRF=0.1
# --- Controle de custo (veja "Controle de custo" em docs/DEPLOY.md) ---
# Precos de referencia: gpt-4o-mini US$0,15 (entrada) / US$0,60 (saida) por 1M tokens; text-embedding-3-small US$0,02/1M.
# Teto de tokens por mes POR ORGANIZACAO (cada cadastro cria uma): 200k ~ US$0,03-0,12 por organizacao/mes
MONTHLY_TOKEN_LIMIT=200000
# Teto mensal SOMANDO TODAS as organizacoes (mes UTC); 0 = desligado. 2M tokens/mes ~ US$0,3-1,2 (o pior caso e tudo saida)
GLOBAL_MONTHLY_TOKEN_LIMIT=2000000
# Cadastros por IP a cada 24 h (0 = desligado) e chave geral do cadastro publico (false = 403, "Cadastro fechado no momento")
REGISTRATION_LIMIT_PER_IP_PER_DAY=5
REGISTRATION_ENABLED=true
# Conta de demonstracao para visitantes (botao "Experimentar a demonstração"; somente leitura, conversas apagadas apos 24 h).
# Ligada, rode o demo-maintenance uma vez e agende-o 1x/dia (docs/DEPLOY.md, "Conta de demonstração"). O chat da demo gasta tokens.
DEMO_LOGIN_ENABLED=false
DEMO_USER_EMAIL=demo@docmind.app
# Precos por 1M de tokens (USD) para a tela de uso; 0 = nao mostra custo
USAGE_PRICE_IN_PER_1M=0.15
USAGE_PRICE_OUT_PER_1M=0.6

# --- Rede ---
# Cloudflare -> cloudflared -> Next -> API = 2 saltos confiaveis (IP real do cliente no rate limit)
TRUST_PROXY=2
AUTH_RATE_LIMIT=10
# limites por minuto e por usuario (vazio = padroes 300 leitura / 60 escrita)
RATE_LIMIT_READ=
RATE_LIMIT_WRITE=
WORKER_CONCURRENCY=1

# --- Cloudflare Tunnel (Zero Trust > Networks > Tunnels > seu tunel > token) ---
TUNNEL_TOKEN=
